# Local development with simulated money only. Never use these credentials
# outside the local Compose environment. The API does not load .env itself:
# export these values before `go run ./cmd/api`, or use Docker Compose.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://transfer:transfer_dev@localhost:5432/transfer_engine?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
HEALTH_TIMEOUT=2s
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
HTTP_BODY_LIMIT_BYTES=1048576
TEST_FUNDS_ENABLED=false
LOG_LEVEL=info
RECONCILIATION_ENABLED=false
REDIS_ADDR=localhost:6379
MESSAGING_ENABLED=false
RABBITMQ_URL=amqp://transfer:transfer_dev@localhost:5672/
MESSAGE_WORKERS=4
MESSAGE_PREFETCH=1
DLQ_REPLAY_ENABLED=false

# Compose overrides DATABASE_URL to use the postgres service hostname and
# these development credentials. Auxiliary clients arrive in phases 3 and 4.
API_PORT=8080
POSTGRES_DB=transfer_engine
POSTGRES_USER=transfer
POSTGRES_PASSWORD=transfer_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_USER=transfer
RABBITMQ_PASSWORD=transfer_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Optional financial HTTP API: Ed25519 public key, standard base64 of 32 raw bytes.
# Never put a private signing key into the API configuration.
FINANCIAL_API_ENABLED=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PUBLIC_KEY=
# Optional OTLP/HTTP collector base URL (must be reachable from the API container).
TELEMETRY_OTLP_ENDPOINT=
